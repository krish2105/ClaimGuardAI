# --- LLM Provider ---
# If left blank, the pipeline runs in MOCK mode (deterministic rule-based
# stand-ins for each LLM call) so the whole system is demoable with zero cost
# and zero external dependency. Set a real key to use live Claude calls.
ANTHROPIC_API_KEY=
CLAUDE_MODEL_REASONING=claude-sonnet-4-5
CLAUDE_MODEL_EXTRACTION=claude-haiku-4-5

# --- Postgres ---
# Local dev default (matches docker-compose service "postgres")
DATABASE_URL=postgresql+psycopg2://claimguard:claimguard@localhost:5432/claimguard

# --- Qdrant ---
# If QDRANT_URL is unset, the app uses an embedded on-disk Qdrant at
# QDRANT_LOCAL_PATH — no server required. Set QDRANT_URL to use Docker/Cloud.
QDRANT_URL=
QDRANT_LOCAL_PATH=./backend/data/qdrant_local
QDRANT_COLLECTION=claimguard_policies

# --- App ---
APP_ENV=development
# Backend runs on 8100 and frontend on 3100 by default (not 8000/3000) to
# avoid clashing with other projects that commonly claim those ports.
CORS_ORIGINS=http://localhost:3100
FRAUD_MODEL_PATH=./backend/models/fraud_model.json
FRAUD_MODEL_META_PATH=./backend/models/fraud_model_meta.json

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8100
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8100
